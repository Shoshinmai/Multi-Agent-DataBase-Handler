# Database (optional - defaults to local PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/sql-handler

# Google Gemini API (required)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative: gemini_api_key=your_gemini_api_key_here

# SQL echo (set true for debugging SQL queries)
SQL_ECHO=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s
